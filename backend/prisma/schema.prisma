generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  TECHNICIAN
  SUPPORT
}
enum EnquiryStatus {
  NEW
  CONTACTED
  SURVEY_SCHEDULED
  QUALIFIED
  QUOTED
  WON
  LOST
}
enum SurveyStatus {
  PENDING
  APPROVED
  REJECTED
}
enum SystemType {
  ON_GRID
  OFF_GRID
  PANEL_SET
}
enum QuoteStatus {
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
}
enum OrderStatus {
  PENDING_ADVANCE
  CONFIRMED
  DISPATCHED
  DELIVERED
  INSTALLED
  CANCELLED
}
enum PaymentKind {
  ADVANCE
  PARTIAL
  FINAL
}
enum AssetStatus {
  IN_STOCK
  DISPATCHED
  INSTALLED
  DAMAGED
}
enum MoveType {
  RECEIPT
  RESERVE
  DISPATCH
  DAMAGE
}
enum JobStatus {
  SCHEDULED
  COMPLETED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum SubsidyStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Counter {
  key String @id
  value Int
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())
  name String
  phone String @unique
  email String?
  address String
  createdAt DateTime @default(now())
  enquiries Enquiry[]
  orders Order[]
  tickets Ticket[]
}

model Enquiry {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  source String @default("WEB")
  requestedKw Int
  systemType SystemType
  notes String?
  status EnquiryStatus @default(NEW)
  assignedToId String?
  nextFollowUp DateTime?
  createdAt DateTime @default(now())
  survey Survey?
  followUps FollowUp[]
  quotations Quotation[]
  @@index([status])
}

model FollowUp {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  note String
  dueAt DateTime?
  userId String?
  createdAt DateTime @default(now())
}

model Survey {
  id String @id @default(cuid())
  enquiryId String @unique
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  roofArea Float
  shadowFreeArea Float
  direction String
  tilt Float
  cableDistance Float
  monthlyBill Float
  gridSuitable Boolean
  notes String?
  technicianId String?
  status SurveyStatus @default(PENDING)
  decidedAt DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(cuid())
  name String @unique
  products Product[]
}

model Product {
  id String @id @default(cuid())
  sku String @unique
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  unit String @default("pcs")
  price Decimal @db.Decimal(12, 2)
  cost Decimal @db.Decimal(12, 2)
  taxRate Decimal @db.Decimal(5, 2) @default(5)
  trackSerial Boolean @default(false)
  isService Boolean @default(false)
  stock Int @default(0)
  reserved Int @default(0)
  lowStockLevel Int @default(0)
  active Boolean @default(true)
  policy WarrantyPolicy?
  assets Asset[]
  packageItems PackageItem[]
}

model WarrantyPolicy {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id])
  name String
  months Int
  warranties Warranty[]
}

model Package {
  id String @id @default(cuid())
  name String @unique
  systemType SystemType
  capacityKw Int
  installationCharge Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
  items PackageItem[]
}
model PackageItem {
  id String @id @default(cuid())
  packageId String
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  fixedQty Int @default(0)
  qtyPerKw Decimal @db.Decimal(8, 2) @default(0)
}

model Quotation {
  id String @id @default(cuid())
  number String @unique
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id])
  packageName String
  version Int
  status QuoteStatus @default(ISSUED)
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @db.Decimal(12, 2) @default(0)
  tax Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  validUntil DateTime
  overrideReason String?
  createdById String
  createdAt DateTime @default(now())
  items QuotationItem[]
  order Order?
}
model QuotationItem {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId String
  description String
  qty Int
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate Decimal @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(12, 2)
}

model Order {
  id String @id @default(cuid())
  number String @unique
  quotationId String @unique
  quotation Quotation @relation(fields: [quotationId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  status OrderStatus @default(PENDING_ADVANCE)
  total Decimal @db.Decimal(12, 2)
  requiredAdvance Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  dispatchedAt DateTime?
  dispatchedById String?
  deliveredAt DateTime?
  items OrderItem[]
  payments Payment[]
  assets Asset[]
  job InstallationJob?
  subsidy Subsidy?
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  description String
  qty Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost Decimal @db.Decimal(12, 2)
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  kind PaymentKind
  method String
  reference String?
  idempotencyKey String @unique
  paidAt DateTime @default(now())
  recordedById String
}

model Supplier {
  id String @id @default(cuid())
  name String @unique
  phone String?
  assets Asset[]
}

model Asset {
  id String @id @default(cuid())
  serial String @unique
  productId String
  product Product @relation(fields: [productId], references: [id])
  status AssetStatus @default(IN_STOCK)
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  createdAt DateTime @default(now())
  warranty Warranty?
  tickets Ticket[]
  @@index([orderId])
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  type MoveType
  qty Int
  orderId String?
  serial String?
  unitCost Decimal? @db.Decimal(12, 2)
  note String?
  userId String?
  createdAt DateTime @default(now())
  @@index([productId])
}

model InstallationJob {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  technicianId String
  scheduledFor DateTime
  status JobStatus @default(SCHEDULED)
  startedAt DateTime?
  finishedAt DateTime?
  hours Float?
  systemKw Float?
  testPassed Boolean?
  checklist Json?
  photos String[]
  customerSignature String?
  completedAt DateTime?
}

model Warranty {
  id String @id @default(cuid())
  assetId String @unique
  asset Asset @relation(fields: [assetId], references: [id])
  policyId String
  policy WarrantyPolicy @relation(fields: [policyId], references: [id])
  customerId String
  startsAt DateTime
  endsAt DateTime
}

model Ticket {
  id String @id @default(cuid())
  number String @unique
  assetId String
  asset Asset @relation(fields: [assetId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  complaint String
  faultCode String?
  priority String @default("NORMAL")
  status TicketStatus @default(OPEN)
  assignedToId String?
  diagnosis String?
  resolutionNotes String?
  partsCost Decimal @db.Decimal(12, 2) @default(0)
  labourCost Decimal @db.Decimal(12, 2) @default(0)
  covered Boolean?
  billedAmount Decimal @db.Decimal(12, 2) @default(0)
  replacementSerial String?
  customerConfirmedAt DateTime?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([status])
}

model Subsidy {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  status SubsidyStatus @default(PENDING)
  reference String?
  claimed Decimal @db.Decimal(12, 2) @default(0)
  received Decimal @db.Decimal(12, 2) @default(0)
  documents String[]
  submittedAt DateTime?
  notes String?
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String
  detail Json?
  createdAt DateTime @default(now())
}
