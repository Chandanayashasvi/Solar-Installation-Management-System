generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  TECHNICIAN
  SUPPORT
  SURVEYOR
  FINANCE
}
enum EnquiryStatus {
  NEW
  CONTACTED
  SURVEY_SCHEDULED
  QUALIFIED
  QUOTED
  WON
  LOST
}
enum SurveyStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SUBMITTED
}
enum SystemType {
  ON_GRID
  OFF_GRID
  PANEL_SET
}
enum QuoteStatus {
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
}
enum OrderStatus {
  PENDING_ADVANCE
  CONFIRMED
  DISPATCHED
  DELIVERED
  INSTALLED
  CANCELLED
}
enum PaymentKind {
  ADVANCE
  PARTIAL
  FINAL
}
enum AssetStatus {
  IN_STOCK
  DISPATCHED
  INSTALLED
  DAMAGED
}
enum MoveType {
  RECEIPT
  RESERVE
  DISPATCH
  DAMAGE
}
enum JobStatus {
  SCHEDULED
  COMPLETED
  IN_PROGRESS
  QUALITY_CHECK
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}
enum TechnicianPaymentStatus {
  RECORDED
  PAID
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum SubsidyStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Counter {
  key String @id
  value Int
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  assignedSurveys Survey[] @relation("SurveyAssignment")
  submittedSurveys Survey[] @relation("SurveySubmission")
  reviewedSurveys Survey[] @relation("SurveyReview")
  technicianPayments TechnicianPayment[]
}

model Customer {
  id String @id @default(cuid())
  name String
  phone String @unique
  email String?
  address String
  createdAt DateTime @default(now())
  enquiries Enquiry[]
  orders Order[]
  tickets Ticket[]
}

model Enquiry {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  source String @default("WEB")
  requestedKw Int
  systemType SystemType
  monthlyBill Float?
  subsidyRequirement String?
  notes String?
  publicSubmissionKey String? @unique
  isDemo Boolean @default(false)
  status EnquiryStatus @default(NEW)
  assignedToId String?
  nextFollowUp DateTime?
  createdAt DateTime @default(now())
  survey Survey?
  followUps FollowUp[]
  quotations Quotation[]
  @@index([status])
}

model FollowUp {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  note String
  dueAt DateTime?
  userId String?
  createdAt DateTime @default(now())
}

model Survey {
  id String @id @default(cuid())
  enquiryId String @unique
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  roofArea Float?
  shadowFreeArea Float?
  direction String?
  tilt Float?
  cableDistance Float?
  monthlyBill Float?
  gridSuitable Boolean?
  notes String?
  shading String?
  photos String[] @default([])
  scheduledFor DateTime?
  submittedAt DateTime?
  submittedById String?
  submittedBy User? @relation("SurveySubmission", fields: [submittedById], references: [id])
  decisionComment String?
  assignedSurveyorId String?
  assignedSurveyor User? @relation("SurveyAssignment", fields: [assignedSurveyorId], references: [id])
  decidedById String?
  decidedBy User? @relation("SurveyReview", fields: [decidedById], references: [id])
  technicianId String?
  status SurveyStatus @default(PENDING)
  decidedAt DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(cuid())
  name String @unique
  products Product[]
}

model Product {
  id String @id @default(cuid())
  sku String @unique
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  unit String @default("pcs")
  price Decimal @db.Decimal(12, 2)
  cost Decimal @db.Decimal(12, 2)
  taxRate Decimal @db.Decimal(5, 2) @default(5)
  trackSerial Boolean @default(false)
  isService Boolean @default(false)
  stock Int @default(0)
  reserved Int @default(0)
  lowStockLevel Int @default(0)
  active Boolean @default(true)
  policy WarrantyPolicy?
  assets Asset[]
  packageItems PackageItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockReservations StockReservation[]
}

model WarrantyPolicy {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id])
  name String
  months Int
  warranties Warranty[]
}

model Package {
  id String @id @default(cuid())
  name String @unique
  systemType SystemType
  capacityKw Int
  installationCharge Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
  items PackageItem[]
}
model PackageItem {
  id String @id @default(cuid())
  packageId String
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  fixedQty Int @default(0)
  qtyPerKw Decimal @db.Decimal(8, 2) @default(0)
}

model Quotation {
  id String @id @default(cuid())
  number String @unique
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id])
  packageName String
  version Int
  status QuoteStatus @default(ISSUED)
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @db.Decimal(12, 2) @default(0)
  tax Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  validUntil DateTime
  overrideReason String?
  createdById String
  createdAt DateTime @default(now())
  items QuotationItem[]
  order Order?
}
model QuotationItem {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId String
  description String
  qty Int
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate Decimal @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(12, 2)
}

model Order {
  id String @id @default(cuid())
  number String @unique
  quotationId String @unique
  quotation Quotation @relation(fields: [quotationId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  status OrderStatus @default(PENDING_ADVANCE)
  total Decimal @db.Decimal(12, 2)
  requiredAdvance Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  dispatchedAt DateTime?
  dispatchedById String?
  deliveredAt DateTime?
  items OrderItem[]
  payments Payment[]
  assets Asset[]
  job InstallationJob?
  subsidy Subsidy?
  invoice Invoice?
  projectExpenses ProjectExpense[]
  stockReservations StockReservation[]
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  description String
  qty Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost Decimal @db.Decimal(12, 2)
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  kind PaymentKind
  method String
  reference String?
  idempotencyKey String @unique
  paidAt DateTime @default(now())
  recordedById String
}

model Supplier {
  id String @id @default(cuid())
  name String @unique
  phone String?
  assets Asset[]
  purchaseOrders PurchaseOrder[]
}

model Asset {
  id String @id @default(cuid())
  serial String @unique
  productId String
  product Product @relation(fields: [productId], references: [id])
  status AssetStatus @default(IN_STOCK)
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  createdAt DateTime @default(now())
  warranty Warranty?
  tickets Ticket[]
  @@index([orderId])
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  type MoveType
  qty Int
  orderId String?
  serial String?
  unitCost Decimal? @db.Decimal(12, 2)
  note String?
  userId String?
  purchaseOrderId String?
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  @@index([productId])
}

model InstallationJob {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  technicianId String
  scheduledFor DateTime
  status JobStatus @default(SCHEDULED)
  startedAt DateTime?
  finishedAt DateTime?
  hours Float?
  systemKw Float?
  testPassed Boolean?
  checklist Json?
  photos String[]
  customerSignature String?
  completedAt DateTime?
  notes String?
  qualityComment String?
  qualityReviewedAt DateTime?
  qualityReviewedById String?
  returnVisitRequired Boolean @default(false)
}

model Warranty {
  id String @id @default(cuid())
  assetId String @unique
  asset Asset @relation(fields: [assetId], references: [id])
  policyId String
  policy WarrantyPolicy @relation(fields: [policyId], references: [id])
  customerId String
  startsAt DateTime
  endsAt DateTime
}

model Ticket {
  id String @id @default(cuid())
  number String @unique
  assetId String
  asset Asset @relation(fields: [assetId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  complaint String
  faultCode String?
  priority String @default("NORMAL")
  status TicketStatus @default(OPEN)
  assignedToId String?
  diagnosis String?
  resolutionNotes String?
  partsCost Decimal @db.Decimal(12, 2) @default(0)
  labourCost Decimal @db.Decimal(12, 2) @default(0)
  covered Boolean?
  billedAmount Decimal @db.Decimal(12, 2) @default(0)
  replacementSerial String?
  customerConfirmedAt DateTime?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  coverageDecidedAt DateTime?
  coverageDecidedById String?
  coverageReason String?
  @@index([status])
}

model Subsidy {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  status SubsidyStatus @default(PENDING)
  stage String @default("DRAFT")
  reference String?
  claimed Decimal @db.Decimal(12, 2) @default(0)
  received Decimal @db.Decimal(12, 2) @default(0)
  documents String[]
  requiredDocuments String[] @default([])
  receivedDocuments String[] @default([])
  submittedAt DateTime?
  applicationDate DateTime @default(now())
  notes String?
  followUpAt DateTime?
  reviewedAt DateTime?
  attachments SubsidyDocument[]
}

model SubsidyDocument {
  id String @id @default(cuid())
  subsidyId String
  subsidy Subsidy @relation(fields: [subsidyId], references: [id], onDelete: Cascade)
  name String
  mimeType String
  content Bytes
  uploadedById String
  createdAt DateTime @default(now())
  @@index([subsidyId, createdAt])
}

model Invoice {
  id String @id @default(cuid())
  number String @unique
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  status InvoiceStatus @default(ISSUED)
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @db.Decimal(12, 2) @default(0)
  tax Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  issuedAt DateTime @default(now())
  dueAt DateTime
  createdById String
  createdAt DateTime @default(now())
  items InvoiceItem[]
}

model InvoiceItem {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty Int
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate Decimal @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(12, 2)
}

model ProjectExpense {
  id String @id @default(cuid())
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  category String
  description String
  amount Decimal @db.Decimal(12, 2)
  reference String?
  incurredAt DateTime @default(now())
  recordedById String
  createdAt DateTime @default(now())
  @@index([orderId, incurredAt])
}

model PurchaseOrder {
  id String @id @default(cuid())
  number String @unique
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  orderedAt DateTime?
  receivedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  items PurchaseOrderItem[]
  stockMovements StockMovement[]
  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id String @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  qty Int
  receivedQty Int @default(0)
  unitCost Decimal @db.Decimal(12, 2)
  @@unique([purchaseOrderId, productId])
}

model StockReservation {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  qty Int
  createdAt DateTime @default(now())
  @@unique([orderId, productId])
}

model TechnicianPayment {
  id String @id @default(cuid())
  technicianId String
  technician User @relation(fields: [technicianId], references: [id])
  periodStart DateTime
  periodEnd DateTime
  hours Float
  rate Decimal @db.Decimal(12, 2)
  amount Decimal @db.Decimal(12, 2)
  paidAmount Decimal @db.Decimal(12, 2) @default(0)
  status TechnicianPaymentStatus @default(RECORDED)
  paidAt DateTime?
  paymentMethod String?
  reference String?
  notes String?
  recordedById String
  createdAt DateTime @default(now())
  @@unique([technicianId, periodStart, periodEnd])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String
  detail Json?
  createdAt DateTime @default(now())
}
